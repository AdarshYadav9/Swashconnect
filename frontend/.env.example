###########################################################
# SwasthyaConnect Frontend Environment Configuration
###########################################################

# Backend API URL
VITE_API_BASE_URL=http://localhost:5001/api

# Firebase Configuration (public keys)
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:aaaaaaaaaaaaaaaaaaaaaa

# Jitsi Meet domain (for video calls)
VITE_JITSI_DOMAIN=meet.jit.si

# Optional: legacy variable (prefer VITE_API_BASE_URL)
# VITE_API_URL=http://localhost:5001/api

# Optional: AI provider keys – DO NOT COMMIT REAL KEYS
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
